---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  rounded?: boolean;
  shadow?: boolean;
  border?: boolean;
  scroll?: boolean;
}

const { src, alt, rounded = false, shadow = false, border = false, scroll = false } = Astro.props;
---

<figure class:list={['col-span-12 sm:col-start-3 sm:col-span-8', scroll && 'scroll-desktop']}>
  <Image
    src={src}
    alt={alt}
    quality="max"
    densities={[1, 2]}
    class:list={[
      'w-full h-auto',
      !scroll && 'my-3 reveal',
      rounded && 'rounded',
      shadow && 'shadow-[0_0_16px_0_rgba(35,26,26,0.08)]',
      border && 'border border-[var(--color-border)]',
    ]}
  />
</figure>
