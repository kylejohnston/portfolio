---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  left: { src: ImageMetadata; alt: string };
  right: { src: ImageMetadata; alt: string };
  rounded?: boolean;
  shadow?: boolean;
  border?: boolean;
  scroll?: boolean;
}

const { left, right, rounded = false, shadow = false, border = false, scroll = false } = Astro.props;
// scroll: put each image in the same fixed-height scrolling frame Scroller uses,
// for full-page screenshots too tall to show at full length.
const imgClass = [
  'w-full h-auto',
  !scroll && 'my-3 reveal',
  rounded && 'rounded',
  shadow && 'shadow-[0_0_16px_0_rgba(35,26,26,0.08)]',
  border && 'border border-[var(--color-border)]',
];
const Frame = scroll ? 'div' : Fragment;
---

<div class="side-by-side col-span-12 grid grid-cols-1 sm:grid-cols-2 gap-6">
  {[left, right].map(({ src, alt }) => (
    <Frame {...(scroll && { class: 'scroll-desktop' })}>
      {scroll && <div class="h-6 bg-muted-brand"></div>}
      <Image src={src} alt={alt} quality="max" densities={[1, 2]} class:list={imgClass} />
    </Frame>
  ))}
</div>
