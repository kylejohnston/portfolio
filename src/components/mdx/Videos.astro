---
import type { ImageMetadata } from 'astro';

interface Props {
  items: { src: string; poster: ImageMetadata; title: string }[];
}

const { items } = Astro.props;
---

<div class="col-span-12 grid grid-cols-1 sm:grid-cols-3 gap-6 my-3">
  {items.map(({ src, poster, title }) => (
    <figure>
      <video class="w-full h-auto" controls playsinline muted preload="none" poster={poster.src}>
        <source src={src} type="video/mp4" />
      </video>
      <figcaption class="text-xs text-center text-[var(--color-muted)] mt-2">{title}</figcaption>
    </figure>
  ))}
</div>
